# ---------------------------------------------------------------- BANCO
# Sem DATABASE_URL, a aplicação usa o Postgres local (silvereng_dev).
# Com ela, aponta para o Supabase. NUNCA versione este arquivo preenchido.
#
# No painel do Supabase: botão "Connect", no TOPO da página do projeto.
#   · Transaction pooler (6543) → é esta que a aplicação usa no dia a dia
#   · Migração (schema e carga) → "Direct connection" (5432) se sua rede tiver
#     IPv6; em rede só-IPv4, use "Session pooler" (5432 no host do pooler).
#     A conexão direta do Supabase só responde em IPv6 sem o add-on de IPv4.
# O host do pooler NÃO dá para montar à mão — copie do painel.
DATABASE_URL=
DATABASE_URL_MIGRACAO=

# Copie para .env e preencha UM dos métodos de autenticação.
BASE44_APP_ID=69ceaaf2ff370a0c3a2d44e7
BASE44_HOST=https://app.base44.com

# Método A (preferido): Personal Access Token do app
# (Base44 > seu app > API/Docs > Autenticação > "+ Criar token de acesso")
BASE44_API_KEY=

# Método B: token JWT da sessão (localStorage do app)
BASE44_BEARER=

# Método C: cookie de sessão copiado do navegador
BASE44_COOKIE=
